<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AetherVpn" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/surface_bg</item>
        <item name="colorPrimaryContainer">@color/accent_primary_container</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_border</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
    </style>

    <style name="Widget.Aether.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Aether.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="android:textColor">@color/surface_bg</item>
    </style>

    <style name="Widget.Aether.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/surface_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Aether.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Aether.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Aether.Chip.Choice.Compact" parent="Widget.Aether.Chip.Choice">
        <item name="chipMinHeight">30dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="android:minHeight">30dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="android:textSize">11.5sp</item>
    </style>
</resources>
