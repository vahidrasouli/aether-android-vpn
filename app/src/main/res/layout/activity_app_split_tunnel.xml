<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <RadioGroup
        android:id="@+id/radioGroupSplitMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioAllApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_all_apps"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/radioExcludeApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_exclude_selected"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/radioIncludeOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/split_include_only"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSaveSplitTunnel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_save" />
</LinearLayout>
