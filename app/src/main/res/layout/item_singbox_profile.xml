<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProfileItem"
    style="@style/Widget.Aether.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Line 1: Radio + Protocol Pill + Profile Name + Right Ping/Country or Error -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioActiveProfile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:buttonTint="@color/accent_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:scaleX="0.85"
                android:scaleY="0.85" />

            <TextView
                android:id="@+id/tvProtocolBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_chain"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="VLESS"
                android:textColor="@color/singbox_accent_light"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Profile Name"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfilePingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfileTestError"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/action_test"
                android:src="@drawable/ic_error_24"
                android:visibility="gone"
                app:tint="@color/error_text" />
        </LinearLayout>

        <!-- Line 2: Server/IP preview + Compact action icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvServerPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="198.51.100.10:443"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnTestProfile"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_test"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow_24"
                app:tint="@color/accent_primary" />

            <ImageButton
                android:id="@+id/btnEditProfile"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_edit_profile"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit_24"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnDeleteProfile"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_delete"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete_24"
                app:tint="@color/error_text" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
